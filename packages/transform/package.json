{
  "name": "@manuscripts/transform",
  "description": "JATS XML <-> ProseMirror transformer for Manuscripts applications",
  "version": "4.4.3",
  "repository": "github:Atypon-OpenSource/manuscripts-transform",
  "license": "Apache-2.0",
  "main": "dist/cjs",
  "module": "dist/es",
  "types": "dist/types",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**",
    "!src/**/__snapshots__/**",
    "!src/tests.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "prosemirror",
    "jats"
  ],
  "scripts": {
    "build": "npm-run-all2 --parallel build:cjs build:es",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:es": "tsc -p tsconfig.build.json",
    "version-file": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "prebuild": "rimraf dist && pnpm version-file",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@manuscripts/schema": "workspace:*",
    "citeproc": "2.4.63",
    "jszip": "3.10.1",
    "lodash": "4.18.1",
    "prosemirror-model": "1.25.0",
    "prosemirror-utils": "1.2.2",
    "uuid": "14.0.0",
    "w3c-xmlserializer": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
