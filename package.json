{
  "name": "manuscripts-transform-monorepo",
  "description": "Monorepo for @manuscripts/schema and @manuscripts/transform",
  "private": true,
  "repository": "github:Atypon-OpenSource/manuscripts-transform",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/*/src --ext .js,.ts",
    "lint:fix": "eslint packages/*/src --fix --ext .js,.ts",
    "prettier": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"*.{js,json}\"",
    "preversion": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "test": "TZ=UTC vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.1",
    "@jats4r/dtds": "0.0.10",
    "@manuscripts/eslint-config": "0.5.1",
    "@types/csl": "npm:csl-json@0.1.0",
    "@types/lodash": "4.17.24",
    "@types/mime": "3.0.4",
    "@types/node": "20.17.46",
    "@types/semver": "7.7.1",
    "@types/w3c-xmlserializer": "2.0.4",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-diff": "2.0.3",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mdx": "3.6.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "libxmljs2": "0.37.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.3",
    "prosemirror-state": "1.4.3",
    "prosemirror-view": "1.39.2",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
